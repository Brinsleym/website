# Cloudflare Pages headers for static files. Pages go through
# functions/_middleware.js, which sets their headers itself: _headers is not
# applied to responses that pass through a Function.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

# Cache static assets. /assets/js/*.min.js is not listed: its name stays the
# same when its contents change, so it keeps Pages' revalidating default.
/images/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/ionicons/*
  Cache-Control: public, max-age=31536000, immutable

# The pages.dev address is for previews only: keep it out of search results.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
